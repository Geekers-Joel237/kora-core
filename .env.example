# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Read by Docker Compose and by the application itself, which imports it through
# spring.config.import — so `./gradlew bootRun` needs no shell export. A real
# environment variable still overrides whatever this file says.

# ─── Which services run on this machine ───────────────────────────────────────
# Read by Docker Compose itself. Postgres always runs; everything else is opt-in.
#   dev    mail,tooling          maildev + pgAdmin
#   perf   mail,observability    maildev + InfluxDB + Grafana
#   prod   <empty>               Postgres alone
COMPOSE_PROFILES=mail,tooling

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Superuser. Consumed by Docker Compose only, to initialise the database on a
# fresh volume. The application never connects with it.
POSTGRES_DB=kora-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_only
DB_HOST=localhost
DB_PORT=5432

# Two application roles, one per job (KC-05 creates them in PostgreSQL).
#   kora_migration  owns the schema, runs Flyway, has DDL rights
#   kora_app        serves traffic, DML only, cannot CREATE or DROP
# Until KC-05 lands, both point at the superuser and nothing changes.
POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_local_only
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=CHANGE_ME_local_only

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@kora.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_local_only
DB_ADMIN_PORT=5050

# ─── Mail (MailDev) ───────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=1080

# Consumed by the prod profile only. MailDev needs no credentials, so leave
# these as-is for local work — the dev and perf profiles never read them.
MAIL_FROM=noreply@kora.dev
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Observability (perf profile) ─────────────────────────────────────────────
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
GRAFANA_PORT=3000

# ─── Application ──────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ─── JWT signing key ──────────────────────────────────────────────────────────
# Minimum 32 characters — HMAC-SHA256 rejects anything shorter.
# Generate your own, never reuse this placeholder:
#
#   openssl rand -base64 48
#
JWT_SECRET=REPLACE_ME_run_openssl_rand_base64_48

# Production environment — VERSIONED TEMPLATE. Contains no secret.
#
# Copy to the server as .env, replace every CHANGE_ME, and run:
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#     SPRING_PROFILES_ACTIVE=prod java -jar kora-core.jar
#
# The application reads .env from its working directory on its own; no shell
# export is needed. Real environment variables still take precedence, so a
# secrets manager can override any line below at runtime.
#
# Keep this file key-for-key identical to .env.example — ConfigurationHygieneTest
# fails the build if the two drift apart.

# --- Which services run -------------------------------------------------------
# Empty: production runs Postgres alone. Mail goes through a real relay, and the
# database is reached through an SSH tunnel onto the loopback port, so neither
# MailDev nor pgAdmin has any place here.
COMPOSE_PROFILES=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=kora-db
POSTGRES_USER=CHANGE_ME_not_postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
# The application runs on the host and reaches the database over the loopback
# port published by docker-compose.prod.yml. It stays localhost until the day the
# application itself moves into a container, when it becomes the service name.
DB_HOST=localhost
DB_PORT=5432

# Two roles, distinct passwords. kora_app must NOT hold DDL rights.
POSTGRES_MIGRATION_USER=kora_migration
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_APP_USER=kora_app
POSTGRES_APP_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# --- pgAdmin ------------------------------------------------------------------
# Unused in production (tooling profile off). Present so the file matches
# .env.example key for key and no variable is silently missing.
PGADMIN_DEFAULT_EMAIL=unused@kora.dev
PGADMIN_DEFAULT_PASSWORD=unused
DB_ADMIN_PORT=5050

# --- Mail ---------------------------------------------------------------------
# A real SMTP relay. The prod Spring profile enables SMTP AUTH and STARTTLS, so
# unlike development these credentials are actually used.
MAIL_HOST=CHANGE_ME_smtp.provider.example
MAIL_SMTP_PORT=587
MAIL_UI_PORT=1080
MAIL_FROM=CHANGE_ME_noreply@your-domain
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

# --- Observability ------------------------------------------------------------
# Unused in production: the observability profile is off and the prod Spring
# profile exports no metrics to InfluxDB.
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
GRAFANA_PORT=3000

# --- Application --------------------------------------------------------------
SERVER_PORT=8081

# --- JWT signing key ----------------------------------------------------------
# MUST be different from every other environment, and at least 32 characters —
# SecurityProperties refuses to start otherwise.
#     openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48

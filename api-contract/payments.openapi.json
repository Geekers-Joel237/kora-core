  "components" : {
    "schemas" : {
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 problem detail",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "The problem's entry in the catalog, https://github.com/Geekers-Joel237/kora-core/blob/develop/docs/problems.md"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "code" : {
            "type" : "string",
            "description" : "Stable machine-readable code of the problem, such as INSUFFICIENT_FUNDS; the catalog lists every one"
          },
          "correlationId" : {
            "type" : "string",
            "description" : "The correlation id of the request, present when it carried or generated one"
          },
          "violations" : {
            "type" : "array",
            "description" : "Present on a 400 raised by request validation",
            "items" : {
              "type" : "object",
              "properties" : {
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "field", "message" ]
            }
          }
        },
        "required" : [ "code", "detail", "instance", "status", "title", "type" ]
      },
      "TransferRequest" : {
        "type" : "object",
        "properties" : {
          "rawPin" : {
            "type" : "string",
            "minLength" : 1
          },
          "amount" : {
            "type" : "number",
            "description" : "Whole major units of the currency: XAF, the only currency today, has no minor unit",
            "minimum" : 1,
            "multipleOf" : 1.0
          },
          "currency" : {
            "type" : "string",
            "maxLength" : 3,
            "minLength" : 3
          },
          "toPhonePrefix" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\+\\d{1,4}"
          },
          "toPhoneNumber" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{8,15}"
          }
        },
        "required" : [ "amount", "currency", "rawPin", "toPhoneNumber", "toPhonePrefix" ]
      },
      "TransactionResponse" : {
        "type" : "object",
        "properties" : {
          "transactionId" : {
            "type" : "string"
          },
          "transactionNumber" : {
            "type" : "string",
            "description" : "Human-readable reference to show the customer"
          },
          "state" : {
            "type" : "string",
            "description" : "Technical lifecycle state; UNKNOWN when the provider outcome is not known yet",
            "enum" : [ "INITIALIZED", "AUTHORIZED", "CAPTURED", "SETTLEMENT_PENDING", "SETTLED", "COMPLETED", "FAILED", "AUTHORIZATION_FAILED", "CAPTURE_FAILED", "SETTLEMENT_FAILED", "REVERSED", "UNKNOWN" ]
          },
          "amount" : {
            "type" : "number",
            "description" : "Whole major units of the currency: XAF, the only currency today, has no minor unit",
            "multipleOf" : 1.0
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 code"
          }
        },
        "required" : [ "amount", "currency", "state", "transactionId", "transactionNumber" ]
      },
      "CashOutRequest" : {
        "type" : "object",
        "properties" : {
          "rawPin" : {
            "type" : "string",
            "minLength" : 1
          },
          "amount" : {
            "type" : "number",
            "description" : "Whole major units of the currency: XAF, the only currency today, has no minor unit",
            "minimum" : 1,
            "multipleOf" : 1.0
          },
          "currency" : {
            "type" : "string",
            "maxLength" : 3,
            "minLength" : 3
          },
          "paymentMethod" : {
            "type" : "string",
            "description" : "One of the listed values, case-insensitive; OM and MOMO are short forms of ORANGE_MONEY and MOBILE_MONEY",
